{
  "name": "seadanceai-transcript-sdk",
  "version": "0.2.0",
  "description": "Typed YouTube transcript toolkit for extraction, language detection, formatting, and AI-ready summaries.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "seadance",
    "ai",
    "youtube",
    "transcript",
    "summary",
    "sdk"
  ],
  "homepage": "https://seavidgen.com",
  "bugs": {
    "url": "https://github.com/Oliver-Silas/yt-transcript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oliver-Silas/yt-transcript-sdk.git"
  },
  "funding": "https://seavidgen.com",
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
